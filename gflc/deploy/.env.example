# GFLC 生产环境变量模板
# 用法：cd gflc/deploy && cp .env.example .env，然后填写所有「CHANGE_ME」项
# 该文件同时用于：compose 变量插值 + app 容器 env_file
# 警告：.env 含明文密钥，禁止提交仓库、禁止打进镜像（backend/.dockerignore 已排除）

APP_ENV=prod
DEV_MODE=false
MOCK_AI=false
STORAGE_BACKEND=minio
LOCAL_STORAGE_DIR=./data/uploads
FRONTEND_DIR=./frontend

# ===== 必填：基础设施密码（compose 插值用）=====
POSTGRES_USER=gflc
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD
POSTGRES_DB=gflc
MINIO_ROOT_USER=gflcadmin
MINIO_ROOT_PASSWORD=CHANGE_ME_MINIO_PASSWORD

# ===== 必填：应用密钥 =====
# 生成命令：python -c "import secrets; print(secrets.token_urlsafe(32))"
LLM_API_KEY=CHANGE_ME_DEEPSEEK_KEY
SESSION_SECRET=CHANGE_ME_RANDOM_32BYTES
COOKIE_SECURE=true

# 数据库 / 缓存（compose 内主机名；app 容器会被 compose 注入正确值）
DATABASE_URL=postgresql+psycopg://gflc:CHANGE_ME_DB_PASSWORD@db:5432/gflc
REDIS_URL=redis://redis:6379/0

# MinIO（app 容器会被 compose 注入正确 key）
MINIO_ENDPOINT=minio:9000
# 浏览器直传用的公网地址：填你的域名或公网 IP:9000，必须浏览器可访问
MINIO_PUBLIC_ENDPOINT=http://CHANGE_ME_HOST:9000
MINIO_BUCKET=gflc
MINIO_SECURE=false

# 允许的浏览器来源（同源部署可只填域名；多个用逗号分隔）
CORS_ORIGINS=https://CHANGE_ME_HOST

# ===== 模型：必须与本机验证过的模型名保持一致 =====
LLM_API_BASE=https://api.deepseek.com/v1
LLM_LIGHT_MODEL=deepseek-flash
LLM_MID_MODEL=deepseek-flash
LLM_STRONG_MODEL=deepseek-v4-pro
LLM_TIMEOUT_SECONDS=120

# 成本护栏（上线后按真实预算收紧）
DAILY_TOKEN_QUOTA=20000
MAX_TASK_TOKENS=8000
DAILY_COST_LIMIT_CNY=250

PDF_ENGINE=pymupdf

# 检索提速：默认规则改写 + 规则重排，零串行 LLM
QA_USE_LLM_REWRITE=false
QA_USE_LLM_RERANK=false
# 留空=强推理模型（质量优先约 18s）；填 deepseek-flash 约 5-8s
QA_ANSWER_MODEL=

# 后台任务看门狗：抽帧/OCR 已有心跳，留足单步余量
TASK_TIMEOUT=1800
TASK_WATCH_INTERVAL=15

# 会话
SESSION_COOKIE=gflc_session
SESSION_TTL_SECONDS=604800

MAX_UPLOAD_MB=512
WHISPER_MODEL=base
