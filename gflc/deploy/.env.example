# GFLC 生产环境变量模板
# 用法：cd gflc/deploy && cp .env.example .env，然后填写所有「CHANGE_ME」项
# 该文件同时用于：compose 变量插值 + app 容器 env_file
# 警告：.env 含明文密钥，禁止提交仓库、禁止打进镜像（backend/.dockerignore 已排除）

APP_ENV=prod
DEV_MODE=false
MOCK_AI=false
STORAGE_BACKEND=minio
LOCAL_STORAGE_DIR=./data/uploads
# 前端产物目录（相对 app 容器工作目录 /app）
#   ./frontend      = 旧版原生单页（保留对照，不再更新）
#   ./frontend/dist = React 19 + AntD 5 构建产物，推荐（构建见 gflc/web/README.md）
FRONTEND_DIR=./frontend/dist

# ===== 必填：基础设施密码（compose 插值用）=====
POSTGRES_USER=gflc
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD
POSTGRES_DB=gflc
MINIO_ROOT_USER=gflcadmin
MINIO_ROOT_PASSWORD=CHANGE_ME_MINIO_PASSWORD

# ===== 必填：应用密钥 =====
# 生成命令：python -c "import secrets; print(secrets.token_urlsafe(32))"
LLM_API_KEY=CHANGE_ME_DEEPSEEK_KEY
SESSION_SECRET=CHANGE_ME_RANDOM_32BYTES
COOKIE_SECURE=true

# 数据库 / 缓存（compose 内主机名；app 容器会被 compose 注入正确值）
DATABASE_URL=postgresql+psycopg://gflc:CHANGE_ME_DB_PASSWORD@db:5432/gflc
REDIS_URL=redis://redis:6379/0

# MinIO（app 容器会被 compose 注入正确 key）
MINIO_ENDPOINT=minio:9000
# 浏览器直传用的公网地址：填你的域名或公网 IP:9000，必须浏览器可访问
MINIO_PUBLIC_ENDPOINT=http://CHANGE_ME_HOST:9000
MINIO_BUCKET=gflc
MINIO_SECURE=false

# 允许的浏览器来源（同源部署可只填域名；多个用逗号分隔）
CORS_ORIGINS=https://CHANGE_ME_HOST

# ===== 模型：必须与本机验证过的模型名保持一致 =====
LLM_API_BASE=https://api.deepseek.com/v1
LLM_LIGHT_MODEL=deepseek-flash
LLM_MID_MODEL=deepseek-flash
LLM_STRONG_MODEL=deepseek-v4-pro
LLM_TIMEOUT_SECONDS=120

# ===== 成本护栏（单一真源：app/core/config.py；同名 env 覆盖）=====
# 口径：PDF 单次 P95 ≤¥0.12（红线 ¥0.15）、视频单次 P95 ≤¥0.4。
# 下方为「单用户每日」上限；日成本 2 元 ≈ 免费层 3 次 PDF 或 5 次视频的成本上界。
BUDGET_ENABLED=true
DAILY_USER_TOKENS=300000
DAILY_USER_COST_CNY=2.0
SINGLE_TASK_TOKENS=60000
MAX_TASK_TOKENS=8000

PDF_ENGINE=pymupdf
# 扫描件（无文字层）视觉 OCR 兜底：自动逐页转录并走同一分块入库链路
OCR_ENABLED=true
# DPI/并发保持 140 / 2：降 DPI 到 110 实测更慢；升到 180 已 A/B 验证无实质收益
# （公式配对数 86→86 / 78→78，字符数 +2.75% / −11.4% 方向不一致，图像字节 +47%），
# 故三档（含 quality）统一 140；3 并发会 429。均勿调整。
OCR_DPI=140
OCR_MAX_TOKENS=16000
OCR_MAX_CONCURRENCY=2
# ===== 28 号诊断报告：OCR 质量×速度旋钮 =====
# 三档预设（同一链路，仅取值不同）：balanced=推荐 / quality=质量换时间 / fast=最快
# 单项环境变量可覆盖预设中的对应取值。
OCR_PROFILE=balanced
# plain=纯文本直出（默认，实测 15.41s/页且公式标记 122≥JSON 的 118）
# json=旧行为（19.76s/页），仅用于回归对照，勿在生产长期开启
OCR_OUTPUT_FORMAT=plain
# JPEG 传输质量：balanced=72 / quality=85 / fast=60
OCR_JPEG_QUALITY=72
# 分栏页先左栏后右栏逐栏转录（A3 双栏试卷防题干/选项错配），几乎零成本
OCR_COLUMN_AWARE=true
# $...$ 配平/长度异常检测，可疑页码记入 stats（不阻断入库）
OCR_FORMULA_CHECK=true
# 页级缓存：key=内容hash+页码+dpi+模型+prompt版本+profile
OCR_CACHE_ENABLED=true
# 失败页串行重试 1 次（提高 max_tokens），仍失败才跳过并记入 stats
OCR_FAILED_PAGE_RETRY=true
# 每页指标写入 task.result.stats（chars/formula_count/seconds/json_retry）
OCR_OBSERVABILITY=true
# >0 时对含公式的页放大块长（如 500），避免公式被切；0=沿用 CHUNK_SIZE=300
OCR_CHUNK_SIZE=0

# 检索提速：默认规则改写 + 规则重排，零串行 LLM
QA_USE_LLM_REWRITE=false
QA_USE_LLM_RERANK=false
# 留空=强推理模型（质量优先约 18s）；填 deepseek-flash 约 5-8s
QA_ANSWER_MODEL=
# 置信度统一量纲（0~1）：重排通过线=该值×5（0.6→3.0，与旧硬编码一致）
QA_MIN_CONFIDENCE=0.6
QA_COVERAGE_FLOOR=0.34
# 单次召回语料上限：触顶会告警而非静默截断，超过需拆分资料或调大此值
RETRIEVAL_MAX_CHUNKS=800

# 后台任务看门狗：抽帧/OCR 已有心跳，留足单步余量
TASK_TIMEOUT=1800
TASK_WATCH_INTERVAL=15

# 会话
SESSION_COOKIE=gflc_session
SESSION_TTL_SECONDS=604800

MAX_UPLOAD_MB=512
WHISPER_MODEL=base
# 长视频转写提速（Whisper 单路会吃满一核就停，必须切片并行）
# 实测 20 核机器：1 片 RTF 0.44（60min≈26min）→ 6 片 RTF 0.09（60min≈5.5min）
WHISPER_PARALLEL=6
WHISPER_CPU_THREADS=8
WHISPER_BEAM=5
# B站/YouTube 的官方（AI）字幕需要登录态；导出 cookies.txt（Netscape 格式）填绝对路径后，
# 平台字幕可直接取材，1 小时视频从分钟级降到秒级。不填则回落本地 ASR。
COOKIES_FILE=
