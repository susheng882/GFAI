# GFLC 环境变量示例：复制为 .env 后按需修改
# cp .env.example .env

APP_ENV=dev

# 运行模式
DEV_MODE=false
MOCK_AI=false            # true=规则生成卡片（无需 Key 也能跑通）
STORAGE_BACKEND=minio    # minio | local
LOCAL_STORAGE_DIR=./data/uploads
FRONTEND_DIR=./frontend

# 数据库（compose 内主机名为 db；本地直跑改 localhost）
DATABASE_URL=postgresql+psycopg://gflc:gflc@db:5432/gflc

# Redis（compose 内为 redis；本地直跑改 localhost）
REDIS_URL=redis://redis:6379/0

# MinIO 对象存储
MINIO_ENDPOINT=minio:9000
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
MINIO_BUCKET=gflc
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false

# DeepSeek（务必填入你自己的 Key）
LLM_API_BASE=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_LIGHT_MODEL=deepseek-chat
LLM_MID_MODEL=deepseek-chat
LLM_STRONG_MODEL=deepseek-reasoner

# 成本护栏
DAILY_TOKEN_QUOTA=20000
MAX_TASK_TOKENS=8000
DAILY_COST_LIMIT_CNY=250

# PDF 引擎：pymupdf（轻）| mineru（质量优先，需另装）
PDF_ENGINE=pymupdf

# 会话
SESSION_SECRET=please-change-to-random
COOKIE_SECURE=false
