# 统一换行符，避免跨平台 diff 噪音
* text=auto eol=lf

# 二进制：不要做文本转换
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.ico binary
*.pdf binary
*.docx binary
*.xlsx binary
*.pptx binary
*.mp4 binary
*.wav binary
*.mp3 binary
*.woff2 binary
*.woff binary

# 脚本保留各自换行
*.bat text eol=crlf
*.cmd text eol=crlf
